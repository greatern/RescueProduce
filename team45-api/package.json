		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node-cron": "^3.0.11",
		"@types/node-schedule": "^2.1.7",
		"@types/web-push": "^3.6.4",
		"nodemon": "^3.1.9",
		"sequelize-cli": "^6.6.3",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.2"
	},
	"bugs": {
		"url": "https://github.com/IFMTYP2025/team45-api/issues"
	},
	"homepage": "https://github.com/IFMTYP2025/team45-api#readme",
