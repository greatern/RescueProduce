{
	"name": "team45-api",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"start:dev": "nodemon ./src/index.ts",
		"dev": "ts-node-dev --respawn --pretty --transpile-only src/index.ts",
		"build": "tsc --build",
		"run": "node ./dist/index.js",
		"test": "echo \"Error: no test specified\" && exit 1",
		"migrate": "sequelize-cli db:migrate",
		"migration:generate": "sequelize-cli migration:generate --name",
		"migration:undo": "sequelize-cli db:migrate:undo",
		"migration:undo:all": "sequelize-cli db:migrate:undo:all",
		"migration:status": "sequelize-cli db:migrate:status",
		"migration:seed": "sequelize-cli db:seed:all",
		"migration:seed:generate": "npx sequelize-cli seed:generate --name",
		"migration:seed:undo": "sequelize-cli db:seed:undo:all",
		"seed:test": "ts-node src/seeders/testDataSeeder.ts",
		"seed:clean": "ts-node src/seeders/testDataSeeder.ts --cleanup",
		"seed:fraud": "ts-node seeders/fraudCaseTestData.ts",
		"seed:tester": "ts-node seeders/seedTestData.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
